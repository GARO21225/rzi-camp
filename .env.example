# Copier ce fichier en ".env" (jamais commité, voir .gitignore) et remplir
# de vraies valeurs sur le serveur. Ne JAMAIS committer le fichier .env réel.

# Mot de passe PostgreSQL du conteneur "db" - generer une valeur forte,
# unique a ce serveur (ne JAMAIS reutiliser "rzi_secret", l'ancienne valeur
# qui etait codee en dur dans docker-compose.yml et donc visible
# publiquement sur GitHub avant ce correctif).
# Generer avec : python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Générer une valeur avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Optionnel — active /api/setup-db/ et /api/backup-complet/ (désactivés
# par défaut si absent). Générer avec la même commande que ci-dessus.
# SETUP_DB_SECRET=

# Adresse utilisée dans les liens envoyés par email/SMS (réinitialisation
# de mot de passe, identifiants de connexion, code OTP) - à mettre à jour
# UNIQUEMENT ici (jamais dans le code) le jour où l'app change d'adresse,
# ex. une fois le domaine app.roxgold-sitelife.com pointé (DNS) sur ce
# serveur et le certificat régénéré pour le couvrir (voir
# frontend/docker-entrypoint-ssl.sh) :
# APP_URL=https://app.roxgold-sitelife.com:5173

# Origines autorisées à appeler l'API depuis un navigateur (CORS) et
# origines de confiance pour le CSRF de l'admin Django - décommenter et
# ajouter le domaine une fois qu'il est actif, sans quoi la valeur de
# secours dans settings.py couvre déjà IP + domaine par défaut :
# CORS_ALLOWED_ORIGINS=https://204.168.229.74:5173,https://app.roxgold-sitelife.com:5173,http://localhost:5173,http://localhost:3000
