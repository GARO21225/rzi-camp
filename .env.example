# Copier ce fichier en ".env" (jamais commité, voir .gitignore) et remplir
# de vraies valeurs sur le serveur. Ne JAMAIS committer le fichier .env réel.

# Générer une valeur avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Optionnel — active /api/setup-db/ et /api/backup-complet/ (désactivés
# par défaut si absent). Générer avec la même commande que ci-dessus.
# SETUP_DB_SECRET=
