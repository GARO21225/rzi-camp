# ─────────────────────────────────────────────────────────────
# Caddyfile — HTTPS automatique pour RZI Camp sur Hetzner
# sans nom de domaine, via le service gratuit sslip.io
#
# 204.168.229.74  →  204-168-229-74.sslip.io  (résout automatiquement
# vers la même IP, aucune configuration DNS nécessaire)
#
# Caddy obtient et renouvelle tout seul un vrai certificat
# Let's Encrypt pour ce nom, car sslip.io est un domaine public
# valide aux yeux de Let's Encrypt.
# ─────────────────────────────────────────────────────────────

204-168-229-74.sslip.io {
	# Le frontend (React/Vite buildé, servi par nginx dans le conteneur frontend)
	reverse_proxy frontend:80

	# Toutes les routes API partent vers le backend Django/Daphne
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	encode gzip
}
